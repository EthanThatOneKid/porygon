[TEMPLATE]
# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token

# Letta Cloud Configuration
LETTA_API_KEY=your_letta_api_key
LETTA_AGENT_ID=your_letta_agent_id

# Message Behavior
LETTA_USE_SENDER_PREFIX=true
LETTA_CONTEXT_MESSAGE_COUNT=5
RESPOND_TO_DMS=true
RESPOND_TO_MENTIONS=true
RESPOND_TO_BOTS=false
RESPOND_TO_GENERIC=false
SURFACE_ERRORS=false

# Optional: Restrict to a specific Discord channel
# DISCORD_CHANNEL_ID=your_channel_id

# App Configuration
PORT=3001

# ── Cloud Sandbox Configuration ──────────────────────────────────────────
# How long the sandbox stays alive after last activity (minutes)
SANDBOX_TTL_MINUTES=5
# How often to refresh the sandbox while session is active (ms)
SANDBOX_REFRESH_INTERVAL_MS=240000

# ── Tool Approval (Human-in-the-Loop) ────────────────────────────────────
# Enable interactive approval for tool calls via Discord buttons
# When false (default), all tools are auto-approved in the sandbox
ENABLE_TOOL_APPROVAL=false
# How long to wait for user approval before denying (ms)
TOOL_APPROVAL_TIMEOUT_MS=60000

# ── Session Isolation ────────────────────────────────────────────────────
# Controls how Letta sessions are mapped to Discord channels/users
#   channel — one session per channel (default, backward compatible)
#   user    — one session per user per channel (more isolation, more sandboxes)
#   global  — single shared session for all channels
SESSION_ISOLATION=channel

# ── Image Handling ───────────────────────────────────────────────────────
ENABLE_IMAGE_HANDLING=false

# ── Timer/Heartbeat ─────────────────────────────────────────────────────
ENABLE_TIMER=false
TIMER_INTERVAL_MINUTES=15
FIRING_PROBABILITY=0.1
