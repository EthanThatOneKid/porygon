{
  "name": "porygon",
  "version": "0.2.0",
  "description": "A stateful Discord bot powered by Letta Cloud",
  "main": "./dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EthanThatOneKid/porygon.git"
  },
  "keywords": [
    "letta",
    "discord",
    "agent",
    "stateful",
    "porygon",
    "ai"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/EthanThatOneKid/porygon/issues"
  },
  "homepage": "https://github.com/EthanThatOneKid/porygon#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@letta-ai/letta-client": "^1.6.2",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
